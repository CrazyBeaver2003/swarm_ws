<?xml version="1.0"?>
<package format="3">
  <name>swarm_evaluation</name><version>0.1.0</version>
  <description>Passive recorder, numerical metrics and plots for fixed-wing swarm experiments.</description>
  <maintainer email="tim@example.com">tim</maintainer><license>Apache-2.0</license>
  
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <test_depend>python3-pytest</test_depend>

  
  <export><build_type>ament_python</build_type></export>
</package>
