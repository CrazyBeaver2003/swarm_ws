# Время, к которому относится измерение, до задержки доставки.
# frame_id указывает общую карту станций: swarm_map.
std_msgs/Header header

# Самолёт и станция, между которыми выполнено измерение.
uint8 vehicle_id
uint32 station_id

# Счётчик измерений для пары (vehicle_id, station_id).
# Увеличивается до моделирования потери пакета.
uint64 sequence

# Измеренное время запроса и ответа, наносекунды.
float64 rtt_ns

# Калиброванная задержка ответа станции, наносекунды.
float64 turnaround_delay_ns

# Дальность, рассчитанная из RTT, метры.
float64 range_m

# Дисперсия случайной ошибки дальности, квадратные метры.
float64 variance_m2

# Можно ли использовать это измерение. 
bool valid